rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Health/Connection Test ---
    match /test/{docId} {
      allow read: if true;
    }

    // --- Users ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'displayName', 'role', 'age', 'photoURL', 'xp', 'rank', 'badges', 'stats', 'streak', 'lastActiveDate',
                      'email', 'city', 'bloodType', 'scdType', 'createdAt'
                    ]);
    }

    // --- User Subcollections (Flat paths for bulletproof matching) ---
    match /users/{userId}/medications/{medId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/appointments/{appointmentId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/waterLogs/{logId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/painLogs/{logId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/symptomLogs/{logId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/emergencyInfo/{infoId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/careVault/{docId} {
      allow read, write: if isOwner(userId);
    }

    function isValidUser(data) {
      return (!('displayName' in data) || (data.displayName is string && data.displayName.size() < 150))
             && (!('role' in data) || (data.role is string && data.role.size() < 150))
             && (!('email' in data) || data.email is string)
             && (!('age' in data) || data.age is int || data.age is float)
             && (!('city' in data) || data.city is string)
             && (!('bloodType' in data) || data.bloodType is string)
             && (!('scdType' in data) || data.scdType is string)
             && (!('streak' in data) || data.streak is int || data.streak is float)
             && (!('photoURL' in data) || data.photoURL is string)
             && (!('lastActiveDate' in data) || data.lastActiveDate is string)
             && (!('xp' in data) || data.xp is int || data.xp is float)
             && (!('rank' in data) || data.rank is string)
             && (!('badges' in data) || data.badges is list)
             && (!('createdAt' in data) || data.createdAt is timestamp)
             && (!('stats' in data) || data.stats is map);
    }

    // --- Chats & Realtime Communication ---
    match /chats/{chatId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /chats/{chatId}/typing/{userId} {
      allow read, write: if isSignedIn();
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // --- Community Posts ---
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidPost(request.resource.data);
      allow update: if isSignedIn() && (
        // Only allow liking by others
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']))
        || (resource.data.authorId == request.auth.uid && isValidPost(request.resource.data))
      );
    }

    function isValidPost(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() < 200
             && data.content is string && data.content.size() > 0
             && data.authorId == request.auth.uid
             && data.createdAt == request.time;
    }
  }
}
